# Copy to dashboard/.env.local.
# Hosted:  Supabase dashboard -> Project Settings -> API
# Local:   npx supabase status
#
# Both values are PUBLIC. The publishable/anon key is constrained by Row Level
# Security; it grants nothing beyond what the signed-in user's policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Projects created before the key rename may still expose an `anon` key. It is
# accepted under this name instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add the service-role key here. It bypasses RLS, and any NEXT_PUBLIC_
# variable is inlined into the browser bundle.
