# Copy to dashboard/.env.local, then fill from:  npx supabase status
# Both values below are PUBLIC. The anon key is constrained by Row Level
# Security; it grants nothing beyond what the signed-in user's policies allow.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-ANON_KEY-from-supabase-status

# Never add the service-role key here. It bypasses RLS, and any NEXT_PUBLIC_
# variable is inlined into the browser bundle.
