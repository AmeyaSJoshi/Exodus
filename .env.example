# Copy to .env.local (dashboard) / configure in Xcode. Never commit real values.

# --- Public: safe to ship in the browser and the iPhone app ---
# These are protected by Row Level Security. The anon key grants no access
# beyond what the RLS policies allow for the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only: NEVER expose to the browser, the iPhone app, or git ---
# The service role bypasses RLS entirely. Use it only in trusted server
# contexts (migrations, admin scripts). There is deliberately no
# NEXT_PUBLIC_ prefix, so Next.js will not inline it into client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Postgres connection for running supabase/tests/security_checks.sql
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
